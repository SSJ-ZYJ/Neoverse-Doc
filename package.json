{
  "name": "neoverse-doc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate:content": "fumadocs-mdx && bun scripts/content-pipeline.ts generate",
    "report:content": "bun scripts/content-pipeline.ts report",
    "sync:ui-assets": "bun scripts/sync-neoverse-ui-assets.ts",
    "predev": "bun run sync:ui-assets && bun run generate:content",
    "dev": "next dev -p 3001",
    "prebuild": "bun run sync:ui-assets && bun run check:architecture && bun run check:content",
    "check:reading": "bun scripts/check-reading-components.mjs",
    "check:architecture": "bun scripts/check-architecture.ts",
    "check:content": "fumadocs-mdx && bun scripts/content-pipeline.ts verify",
    "build": "next build --webpack",
    "postbuild": "bun scripts/verify-build-output.ts",
    "start": "serve out",
    "postinstall": "bun run sync:ui-assets && fumadocs-mdx",
    "typecheck": "next typegen && fumadocs-mdx && tsc --noEmit",
    "lint": "biome lint .",
    "test": "bun test",
    "format": "biome format --write .",
    "check": "biome check --write ."
  },
  "dependencies": {
    "@fuma-translate/react": "^1.0.2",
    "@giscus/react": "^3.1.0",
    "@mogeko/maple-mono-cn": "^7.9.0",
    "@neoverse-ui/giscus-theme": "file:../Neoverse-UI/.release/packages/neoverse-ui-giscus-theme-0.1.0.tgz",
    "@neoverse-ui/glass-runtime": "file:../Neoverse-UI/.release/packages/neoverse-ui-glass-runtime-0.1.0.tgz",
    "@neoverse-ui/motion": "file:../Neoverse-UI/.release/packages/neoverse-ui-motion-0.1.0.tgz",
    "@neoverse-ui/react": "file:../Neoverse-UI/.release/packages/neoverse-ui-react-0.1.0.tgz",
    "@neoverse-ui/tailwind": "file:../Neoverse-UI/.release/packages/neoverse-ui-tailwind-0.1.0.tgz",
    "@neoverse-ui/tokens": "file:../Neoverse-UI/.release/packages/neoverse-ui-tokens-0.1.0.tgz",
    "@orama/tokenizers": "^3.1.18",
    "framer-motion": "^13.0.0",
    "fumadocs-core": "^16.14.2",
    "fumadocs-mdx": "^15.2.2",
    "fumadocs-ui": "^16.14.2",
    "iconify": "^1.4.0",
    "katex": "^0.18.1",
    "lucide-react": "^1.30.0",
    "mermaid": "^11.16.1",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "pinyin-pro": "^3.28.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-katex": "^7.0.1",
    "remark-github-blockquote-alert": "^2.1.0",
    "remark-math": "^6.0.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "puppeteer": "25.5.0",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@neoverse-ui/motion": "file:../Neoverse-UI/.release/packages/neoverse-ui-motion-0.1.0.tgz",
    "@neoverse-ui/tailwind": "file:../Neoverse-UI/.release/packages/neoverse-ui-tailwind-0.1.0.tgz",
    "@neoverse-ui/tokens": "file:../Neoverse-UI/.release/packages/neoverse-ui-tokens-0.1.0.tgz"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "@biomejs/biome",
    "puppeteer",
    "sharp",
    "unrs-resolver"
  ]
}
